# Copy to .env on the prod box (next to docker-compose.prod.yml) and fill in.
# docker compose reads this file automatically when named `.env`.

# --- Postgres (used by the postgres container + composed into DATABASE_URL) ---
POSTGRES_USER=cpp
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=care_provider_platform

# --- App URLs (must match the public hostname users hit) ---
APP_BASE_URL=https://app.example.com
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXTAUTH_URL=https://app.example.com

# --- NextAuth ---
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_openssl_rand_base64_32

# --- Ultramsg (WhatsApp) ---
ULTRAMSG_INSTANCE_ID=instanceXXXXX
ULTRAMSG_TOKEN=your_prod_token
ULTRAMSG_BASE_URL=https://api.ultramsg.com
ULTRAMSG_DEFAULT_COUNTRY_CODE=91
WHATSAPP_LOGIN_LINK_TTL_MIN=15

# --- Bootstrap admin (seeded on first boot; password is reset to this value
#     each boot — change it in-app and remove from env after first login). ---
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
ADMIN_NAME=Super Admin

# --- Cron auth (for POST /api/cron/reminders) ---
CRON_SECRET=CHANGE_ME_openssl_rand_base64_32

# --- Port the app listens on (host side). Put a reverse proxy in front for HTTPS. ---
APP_PORT=3000

# --- Run prisma seed on every boot. Idempotent — safe to leave true. ---
SEED_ON_BOOT=true
