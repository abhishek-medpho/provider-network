// Care Provider Platform — Prisma schema
//
// Six core entities:
//   Attribute       — typed atomic data points (with validation + options)
//   ProfileType     — bundles of attributes per role (NURSE, PHLEBO, GDA, ...)
//   FormTemplate    — a published rendering of a ProfileType (sections, layout)
//   MessageTemplate — WhatsApp copy with merge tags
//   Campaign        — orchestrates a CSV batch → invite → form → reminders
//   CareProvider    — canonical onboarded entity, phone as natural key
//
// Plus operational tables: LeadBatch, CampaignMember, CareProviderEvent,
// WhatsAppMessage, IncomingMessage, and NextAuth's (User, Account, Session,
// VerificationToken, AdminAuthOtp).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum AttributeType {
  TEXT
  LONG_TEXT
  NUMBER
  EMAIL
  PHONE
  PINCODE
  DATE
  YEAR
  SINGLE_SELECT
  MULTI_SELECT
  BOOLEAN
  FILE_IMAGE
  FILE_DOC
  SELFIE
  OTP_VERIFIED_PHONE
  RICH_TEXT
  SECTION_HEADING
  INFO_BLOCK
  /// Lat/lng captured via HTML5 Geolocation API. Stored as JSON:
  /// { lat, lng, accuracy (meters), capturedAt (ISO string) }
  GEO_POINT
}

enum PiiLevel {
  NONE
  LOW
  MEDIUM
  HIGH
}

enum CareProviderStatus {
  LEAD                  // imported / no form action yet
  ENGAGED               // opened the form link
  PROFILED              // completed primary onboarding form
  PENDING_VERIFICATION  // documents submitted, awaiting review
  VERIFIED              // documents verified by admin
  ACTIVE                // available to receive orders
  PAUSED                // temporarily unavailable
  BLOCKED               // permanently disabled
  OPTED_OUT             // requested no contact
  REJECTED              // failed verification
}

enum CampaignStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
  ARCHIVED
}

enum MessageChannel {
  WHATSAPP
  SMS
  EMAIL
}

enum MessageTemplateKind {
  INVITE
  REMINDER
  CONFIRMATION
  REJECTION
  ACTIVATION
  CUSTOM
}

enum WhatsAppMessageStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

/// How outbound campaign sends are paced.
///   IMMEDIATE — old behavior: launch fires a paced loop with 3-10s gaps.
///              Fine for tiny bursts; risky at scale.
///   PACED    — scheduler computes a per-member scheduledSendAt across the
///              dispatchTTLHours window, respecting quiet hours and an
///              hourly target. Cron /api/cron/dispatch ticks every minute
///              and fires whatever is due. Safe for bulk outreach.
enum CampaignDispatchMode {
  IMMEDIATE
  PACED
}

enum EmailMessageStatus {
  QUEUED
  SENDING
  SENT       // SMTP handed off to Gmail
  DELIVERED  // Bounced-not received (we don't get a positive delivery signal without webhooks)
  OPENED     // Pixel hit
  CLICKED    // At least one link tracked
  BOUNCED
  FAILED
}

/// Per-campaign channel routing. Tells the dispatcher which channel(s) to
/// fire for each member based on what contact info they have.
enum ChannelStrategy {
  WHATSAPP_ONLY    // Hard-fail if no phone
  EMAIL_ONLY       // Hard-fail if no email
  BOTH             // Fire both channels if both contact methods present
  WHATSAPP_FIRST   // WhatsApp if phone exists, else email fallback
  EMAIL_FIRST      // Email if email exists, else WhatsApp fallback
}

enum CampaignMemberStatus {
  PENDING
  SENT
  ENGAGED      // form opened
  SUBMITTED    // form submitted
  COMPLETED    // all submission parts done
  OPTED_OUT
  FAILED
}

enum FormTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// What stage of the care-provider lifecycle this form serves.
/// Drives which block types are typically used and which actions
/// the renderer wires up.
enum FormPurpose {
  ONBOARDING                // capture provider profile (invite form)
  APPOINTMENT_CONFIRM       // show patient details + accept/decline buttons
  APPOINTMENT_EXECUTION     // during visit: display details + capture data
  POST_APPOINTMENT          // completion form
  GIG_COMPLETION            // SOP form the provider fills to close a gig
  CUSTOM
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  OPS
  VIEWER
}

/// What lifecycle stage a reminder rule targets. The runner uses this to
/// pick the right audience query.
enum ReminderKind {
  CAMPAIGN_FOLLOWUP       // implemented: campaign member hasn't submitted yet
  VERIFICATION_STUCK      // implemented: PROFILED/PENDING_VERIFICATION too long
  PROVIDER_INACTIVE       // implemented: ACTIVE provider gone cold
  APPOINTMENT_PRE         // future: T-N before scheduled appointment
  APPOINTMENT_PENDING     // future: order assigned but unaccepted
  APPOINTMENT_POST        // future: post-service form not completed
  DOCUMENT_EXPIRY         // future: doc expires soon
  CUSTOM                  // generic: status-filter + cooldown
}

enum ReminderSendStatus {
  SCHEDULED
  SENT
  FAILED
  SUPPRESSED              // skipped (opt-out / cooldown / cap hit)
  CANCELLED
}

// ============================================================================
// ATTRIBUTES & PROFILE TYPES
// ============================================================================

/// An atomic data point. Both system attributes (phone, name, status) and
/// custom attributes (skill list, expected rate) live here. System attributes
/// back real columns on CareProvider; custom attributes flow into the
/// CareProvider.attributes JSON column.
model Attribute {
  id              String          @id @default(cuid())
  key             String          @unique // snake_case identifier
  label           String
  labelLocalized  Json?           // { en, hi, kn, ta, te }
  helpText        String?
  helpTextLocalized Json?
  type            AttributeType
  options         Json?           // [{ value, label, labelLocalized }] for SELECT types
  validation      Json?           // { required, min, max, regex, fileMaxKb, ... }
  piiLevel        PiiLevel        @default(NONE)
  isSearchable    Boolean         @default(false)
  isSystem        Boolean         @default(false) // system attrs cannot be deleted
  category        String?         // optional grouping ("personal", "skills", "commercials")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  archivedAt      DateTime?

  profileTypeAttrs ProfileTypeAttribute[]

  @@index([key])
  @@index([archivedAt])
}

/// A role definition. Bundles attributes + role-level config flags.
model ProfileType {
  id                    String   @id @default(cuid())
  code                  String   @unique // "NURSE", "PHLEBO", ...
  label                 String
  labelLocalized        Json?
  description           String?
  icon                  String?
  color                 String?
  requiresCouncilReg    Boolean  @default(false)
  requiresQualCert      Boolean  @default(false)
  sortOrder             Int      @default(0)
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  attributes            ProfileTypeAttribute[]
  formTemplates         FormTemplate[]
  campaigns             Campaign[]
  careProviders         CareProvider[]
  messageTemplates      MessageTemplate[]
  gigs                  Gig[]

  @@index([active])
}

/// Join: ProfileType ↔ Attribute, with per-binding config (required, order,
/// section, conditional logic).
model ProfileTypeAttribute {
  id              String      @id @default(cuid())
  profileTypeId   String
  attributeId     String
  isRequired      Boolean     @default(false)
  sortOrder       Int         @default(0)
  sectionKey      String?     // group attributes into sections (e.g. "basics", "skills")
  conditionalLogic Json?      // { showIf: { attributeKey, in: [...] } }

  profileType     ProfileType @relation(fields: [profileTypeId], references: [id], onDelete: Cascade)
  attribute       Attribute   @relation(fields: [attributeId], references: [id])

  @@unique([profileTypeId, attributeId])
  @@index([profileTypeId])
}

// ============================================================================
// FORM TEMPLATES
// ============================================================================

/// A configurable form surface. One template per (purpose × profile type ×
/// version). Sections contain typed blocks (ATTRIBUTE / DISPLAY / INFO /
/// HEADING) so the same model serves onboarding (mostly inputs), appointment
/// confirmation (mostly display + buttons), and execution forms (mixed).
model FormTemplate {
  id              String              @id @default(cuid())
  name            String
  purpose         FormPurpose         @default(ONBOARDING)
  profileTypeId   String?             // null = applies to all profile types
  layout          String              @default("ONE_PER_SCREEN") // ONE_PER_SCREEN | MULTI_PAGE | SINGLE_PAGE

  /// [{ key, title, description, blocks: [
  ///   { type: 'ATTRIBUTE', attributeId, isRequired?, overrideLabel? },
  ///   { type: 'DISPLAY', label, contextPath, helpText? },
  ///   { type: 'INFO', text },
  ///   { type: 'HEADING', text }
  /// ]}]
  sections        Json

  /// [{ key, label, kind, style? }]
  /// kind: SUBMIT | ACCEPT | DECLINE | COMPLETE | NEXT
  actions         Json?

  submitParts     Json?               // [{ partKey, sectionKeys, statusOnSubmit, nextMessageTemplateId }]
  themeId         String?
  status          FormTemplateStatus  @default(DRAFT)
  version         Int                 @default(1)
  publishedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  archivedAt      DateTime?

  profileType     ProfileType?        @relation(fields: [profileTypeId], references: [id])
  campaigns       Campaign[]
  sopForGigs      Gig[]               @relation("GigSopForm")

  @@index([profileTypeId, status])
  @@index([purpose, status])
}

// ============================================================================
// MESSAGE TEMPLATES
// ============================================================================

/// WhatsApp / SMS / Email copy with merge tags. One row per
/// (template, channel, language) so localized variants are first-class.
model MessageTemplate {
  id            String              @id @default(cuid())
  code          String              // identifier like "nurse_invite_v1"
  name          String
  channel       MessageChannel      @default(WHATSAPP)
  language      String              @default("en") // ISO code
  kind          MessageTemplateKind @default(INVITE)
  /// Email-only: subject line. Supports {{merge_tags}} same as body.
  subject       String?
  body          String              // template body / text fallback
  /// Email-only: HTML body. If null on an EMAIL template, the renderer
  /// auto-wraps `body` in a minimal HTML template (see channels/email.ts).
  html          String?
  attachments   Json?               // [{ type, url, caption }]
  cta           Json?               // { type: LINK, label, urlPattern }
  variables     String[]            // declared merge tags for validation
  profileTypeId String?             // optionally scoped to a role
  active        Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  profileType   ProfileType?        @relation(fields: [profileTypeId], references: [id])

  inviteForCampaigns       Campaign[] @relation("CampaignInviteTemplate")
  inviteEmailForCampaigns  Campaign[] @relation("CampaignInviteEmail")
  whatsappMessages         WhatsAppMessage[]
  emailMessages            EmailMessage[]
  reminderRules            ReminderRule[]

  @@unique([code, language])
  @@index([profileTypeId, active])
}

// ============================================================================
// LEADS, CAMPAIGNS, ENGAGEMENT
// ============================================================================

/// One row per CSV upload. Tracks who uploaded what, when, and with what
/// column mapping. Source of truth for "where did this care provider come from".
model LeadBatch {
  id              String   @id @default(cuid())
  name            String
  source          String?  // "Apna April Drive", "Workindia 2026-05", etc.
  filename        String
  uploadedById    String?
  rowCount        Int      @default(0)
  newCount        Int      @default(0)  // care providers newly created from this batch
  matchedCount    Int      @default(0)  // existing care providers enriched
  columnMapping   Json?    // { csvColumn → attributeKey }
  notes           String?
  createdAt       DateTime @default(now())

  uploadedBy      User?    @relation(fields: [uploadedById], references: [id])
  campaigns       Campaign[]
  careProviders   CareProvider[]
}

/// Orchestrates a batch: which leads, which form, which invite,
/// which reminder rules, throttling, stop conditions.
model Campaign {
  id                       String         @id @default(cuid())
  name                     String
  profileTypeId            String
  formTemplateId           String?
  /// WhatsApp invite template (existing). Used when channel strategy
  /// includes WhatsApp.
  inviteMessageTemplateId  String?
  /// Email invite template (new). Used when channel strategy includes
  /// email. May be null even if WHATSAPP_ONLY — that's fine.
  inviteEmailTemplateId    String?
  /// How to route invites for each member. Defaults to WHATSAPP_ONLY so
  /// existing campaigns continue behaving exactly as before.
  channelStrategy          ChannelStrategy @default(WHATSAPP_ONLY)
  leadBatchId              String?

  /// [{ triggerAfterHours, condition, messageTemplateId, maxSends }]
  reminderRules            Json?
  /// e.g. ["status>=VERIFIED", "optedOut=true"]
  stopConditions           Json?
  /// { maxSendsPerDay, maxSendsPerProvider }
  throttle                 Json?

  status                   CampaignStatus @default(DRAFT)
  startedAt                DateTime?
  completedAt              DateTime?

  // Background-launch progress. Action returns immediately and the
  // dispatch loop streams updates here; UI polls /launch-status.
  launchInProgress         Boolean        @default(false)
  launchStartedAt          DateTime?
  launchCompletedAt        DateTime?
  launchTotal              Int            @default(0)
  launchSent               Int            @default(0)
  launchFailed             Int            @default(0)
  launchError              String?

  // ───────────── Bulk dispatch throttling ─────────────
  // Used when the campaign sends out invites/reminders to many providers.
  // Transactional sends (form submission confirmation, profile activation,
  // etc.) bypass these and go out immediately via sendTransactional().
  dispatchMode             CampaignDispatchMode @default(PACED)
  /// Target messages per hour. WhatsApp anti-spam fires above ~30/hr
  /// sustained for a single number. Default 27 with random jitter.
  hourlyTarget             Int            @default(27)
  /// Cohort size range — each hour, we pick a random size in
  /// [cohortMin, cohortMax] of pending members for that hour. Adds
  /// per-hour entropy on top of the inter-message jitter.
  cohortMin                Int            @default(35)
  cohortMax                Int            @default(50)
  /// How many hours we're willing to spread sends across. If there
  /// are more leads than hourlyTarget * dispatchTTLHours, the overflow
  /// either rolls into more hours or gets logged as un-sent (TBD).
  dispatchTTLHours         Int            @default(48)
  /// Active sending window — local-time bounds during which sends may
  /// fire. Outside this window is "quiet hours" (no sends). Defaults to
  /// IST waking hours (8am–9pm) so we don't ping providers in the middle
  /// of the night.
  activeHourStart          Int            @default(8)
  activeHourEnd            Int            @default(21)
  /// IANA timezone used to interpret activeHourStart/End. Stored so
  /// global campaigns can override per-region.
  dispatchTimezone         String         @default("Asia/Kolkata")

  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  profileType              ProfileType        @relation(fields: [profileTypeId], references: [id])
  formTemplate             FormTemplate?      @relation(fields: [formTemplateId], references: [id])
  inviteMessageTemplate    MessageTemplate?   @relation("CampaignInviteTemplate", fields: [inviteMessageTemplateId], references: [id])
  inviteEmailTemplate      MessageTemplate?   @relation("CampaignInviteEmail", fields: [inviteEmailTemplateId], references: [id])
  leadBatch                LeadBatch?         @relation(fields: [leadBatchId], references: [id])

  members                  CampaignMember[]
  whatsappMessages         WhatsAppMessage[]
  emailMessages            EmailMessage[]
  reminderRuleItems        ReminderRule[]   @relation("CampaignReminderRules")

  @@index([status])
  @@index([profileTypeId])
}

/// Join: CareProvider ↔ Campaign. Tracks per-provider state inside a campaign:
/// how many messages sent, where they are in the funnel, etc.
model CampaignMember {
  id              String                @id @default(cuid())
  campaignId      String
  careProviderId  String
  status          CampaignMemberStatus  @default(PENDING)
  remindersSent   Int                   @default(0)
  lastSentAt      DateTime?
  engagedAt       DateTime?
  submittedAt     DateTime?
  completedAt     DateTime?
  optedOutAt      DateTime?
  /// When this member is scheduled to receive the invite. Set by the
  /// scheduler at launch time for PACED campaigns; null for IMMEDIATE.
  /// Cron /api/cron/dispatch picks up members where this is <= now() and
  /// status is still PENDING.
  scheduledSendAt DateTime?
  /// Unique token used in the form magic-link URL for this (campaign, provider)
  /// pair. Lets us identify who opened/submitted without a login.
  token           String                @unique @default(cuid())
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  campaign        Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  careProvider    CareProvider          @relation(fields: [careProviderId], references: [id], onDelete: Cascade)
  reminderLogs    ReminderLog[]

  @@unique([campaignId, careProviderId])
  @@index([status])
  @@index([careProviderId])
  @@index([scheduledSendAt, status])
}

// ============================================================================
// CARE PROVIDERS
// ============================================================================

/// The canonical onboarded entity. Phone is the natural key — same phone in
/// two CSV uploads enriches, not duplicates.
model CareProvider {
  id                  String              @id @default(cuid())
  phone               String              @unique // E.164-ish, country-code prefixed, no plus
  phoneVerifiedAt     DateTime?

  /// Current role this provider is associated with. Null until profile type
  /// is chosen (typically via the form).
  profileTypeId       String?

  /// System attributes — real columns
  name                String?
  email               String?
  status              CareProviderStatus  @default(LEAD)
  source              String?             // free-text label of where they came from
  language            String              @default("en")
  pincodeHome         String?
  selfieUrl           String?

  /// Custom attribute values (defined via Attribute table). JSONB for now;
  /// schema-flexible. Move to EAV later if analytics demand it.
  attributes          Json                @default("{}")

  /// Operational metadata
  lastContactedAt     DateTime?
  optedOutAt          DateTime?
  blockedReason       String?
  leadBatchId         String?

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  profileType         ProfileType?        @relation(fields: [profileTypeId], references: [id])
  leadBatch           LeadBatch?          @relation(fields: [leadBatchId], references: [id])
  events              CareProviderEvent[]
  campaignMemberships CampaignMember[]
  whatsappMessages    WhatsAppMessage[]
  emailMessages       EmailMessage[]
  formResponses       FormResponse[]
  reminderLogs        ReminderLog[]
  gigResponses        GigResponse[]
  assignedGigs        Gig[]               @relation("GigAssignee")

  @@index([status])
  @@index([profileTypeId])
  @@index([pincodeHome])
  @@index([phone])
}

/// Append-only audit log of every meaningful action on a care provider.
/// Replaces the temptation to scatter "lastFoo" columns everywhere.
model CareProviderEvent {
  id              String       @id @default(cuid())
  careProviderId  String
  type            String       // "MESSAGE_SENT", "FORM_OPENED", "FORM_SUBMITTED", "STATUS_CHANGED", ...
  payload         Json?
  createdAt       DateTime     @default(now())

  careProvider    CareProvider @relation(fields: [careProviderId], references: [id], onDelete: Cascade)

  @@index([careProviderId, createdAt])
  @@index([type])
}

/// Raw submission record. One row per form-part submit. Always preserve the
/// raw payload — even after CareProvider.attributes is updated.
model FormResponse {
  id              String       @id @default(cuid())
  careProviderId  String
  formTemplateId  String?
  partKey         String?      // e.g. "part_a", "part_b"
  data            Json
  createdAt       DateTime     @default(now())

  careProvider    CareProvider @relation(fields: [careProviderId], references: [id], onDelete: Cascade)

  @@index([careProviderId])
}

// ============================================================================
// WHATSAPP MESSAGES (outbound + inbound)
// ============================================================================

/// Outbound message log — every WA send (invite, reminder, login link, etc.)
model WhatsAppMessage {
  id                  String                @id @default(cuid())
  careProviderId      String?
  campaignId          String?
  messageTemplateId   String?
  toPhone             String
  body                String
  attachments         Json?
  status              WhatsAppMessageStatus @default(QUEUED)
  ultramsgMessageId   String?
  errorMessage        String?
  sentAt              DateTime?
  deliveredAt         DateTime?
  readAt              DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  careProvider        CareProvider?         @relation(fields: [careProviderId], references: [id])
  campaign            Campaign?             @relation(fields: [campaignId], references: [id])
  messageTemplate     MessageTemplate?      @relation(fields: [messageTemplateId], references: [id])

  @@index([toPhone])
  @@index([status])
  @@index([careProviderId])
}

/// Runtime configuration for outbound channels (WhatsApp/Email/SMS).
/// One row per channel. Stored as JSON so each channel can have its own
/// shape without schema migrations every time we add a setting.
///
/// Loader (lib/channels/config.ts) reads DB first and falls back to env
/// vars for backwards compat with the original .env-driven setup. This lets
/// admins rotate keys from the UI without touching `.env` or re-deploying.
///
/// SECURITY NOTE: values are plaintext for MVP. The DB is on the same
/// trust boundary as the .env file (both readable by anyone with server
/// access), so this isn't strictly worse — but encrypting the `config`
/// blob with a SETTINGS_KEY env var is a planned hardening.
model ChannelConfig {
  id          String         @id @default(cuid())
  channel     MessageChannel @unique
  /// Whether the channel is enabled for outbound dispatch.
  enabled     Boolean        @default(true)
  /// Shape depends on channel:
  ///   WHATSAPP: { instanceId, token, baseUrl?, defaultCountryCode? }
  ///   EMAIL:    { gmailUser, gmailAppPassword, fromName?, replyTo? }
  ///   SMS:      (future)
  config      Json           @default("{}")
  updatedAt   DateTime       @updatedAt
  updatedById String?
}

/// Outbound email log — parallel to WhatsAppMessage. Open / click counts
/// are filled by the /api/track/email/* endpoints when the recipient's
/// client loads the tracking pixel or follows a wrapped link.
model EmailMessage {
  id                  String              @id @default(cuid())
  careProviderId      String?
  campaignId          String?
  messageTemplateId   String?

  toEmail             String
  subject             String
  /// Plain-text fallback (also stored for previewing in admin)
  body                String
  /// Rendered HTML with tracking already injected (pixel + click wrappers)
  html                String?

  status              EmailMessageStatus  @default(QUEUED)
  /// SMTP message-id returned by Gmail. Useful for grepping bounce DSNs.
  providerMessageId   String?
  errorMessage        String?

  sentAt              DateTime?
  /// First time the open pixel was fetched. Multiple opens roll up here +
  /// in EmailEvent rows.
  openedAt            DateTime?
  firstClickedAt      DateTime?
  openCount           Int                 @default(0)
  clickCount          Int                 @default(0)

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  careProvider        CareProvider?       @relation(fields: [careProviderId], references: [id])
  campaign            Campaign?           @relation(fields: [campaignId], references: [id])
  messageTemplate     MessageTemplate?    @relation(fields: [messageTemplateId], references: [id])

  events              EmailEvent[]

  @@index([toEmail])
  @@index([status])
  @@index([careProviderId])
  @@index([campaignId])
}

/// One row per open or click event. Multiple opens/clicks per EmailMessage
/// are normal — keep the granular log for funnel analysis later.
model EmailEvent {
  id              String       @id @default(cuid())
  emailMessageId  String
  kind            String       // "OPEN" | "CLICK"
  /// For CLICK events: the original URL the recipient was redirected to.
  url             String?
  userAgent       String?
  ipAddress       String?
  createdAt       DateTime     @default(now())

  emailMessage    EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)

  @@index([emailMessageId])
  @@index([kind])
}

/// Inbound message from Ultramsg webhook. Even if we don't show a chat UI in
/// MVP, store everything — opt-outs and questions land here.
model IncomingMessage {
  id              String   @id @default(cuid())
  fromPhone       String
  body            String?
  attachments     Json?
  ultramsgPayload Json?
  isOptOut        Boolean  @default(false)
  handled         Boolean  @default(false)
  receivedAt      DateTime @default(now())

  @@index([fromPhone])
  @@index([handled])
}

// ============================================================================
// AUTH (NextAuth v5 with WhatsApp magic link)
// ============================================================================

/// Admin user. Email + password authentication.
/// (Care providers don't have User rows — they're identified via
/// tokenized form URLs against CampaignMember.token.)
model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  name          String?
  phone         String?    @unique // optional; for ops contact, not auth
  emailVerified DateTime?
  image         String?
  role          AdminRole  @default(VIEWER)
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastLoginAt   DateTime?

  accounts      Account[]
  sessions      Session[]
  leadBatches   LeadBatch[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// NextAuth verification tokens — used for magic links over WhatsApp.
/// `identifier` is the phone number (E.164-like, no plus).
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================================
// REMINDER RULES + LOGS
// ============================================================================

/// A configured, named rule that the reminder runner evaluates on each tick.
/// Rules can be campaign-scoped (CAMPAIGN_FOLLOWUP) or global (VERIFICATION_STUCK,
/// PROVIDER_INACTIVE). The runner queries the right audience for each kind,
/// checks cooldowns + caps, and schedules ReminderLog rows.
model ReminderRule {
  id                  String       @id @default(cuid())
  name                String
  description         String?
  kind                ReminderKind

  /// Optional campaign scope. Required for CAMPAIGN_FOLLOWUP; null for global kinds.
  campaignId          String?

  /// WhatsApp/SMS template to send. Null means use a hardcoded fallback body.
  messageTemplateId   String?

  /// Hours after the trigger event before sending (e.g. 24 = 1 day after
  /// PENDING with no submission). Decimal allowed (0.5 = 30 min).
  delayHours          Float        @default(24)

  /// Minimum hours between two sends of this rule to the same provider.
  cooldownHours       Float        @default(72)

  /// Hard cap on how many times this rule fires per care provider (0 = unlimited).
  maxSendsPerProvider Int          @default(3)

  /// JSON array of CareProviderStatus or CampaignMemberStatus values that the
  /// target must be in for this rule to fire. Null = no status filter.
  targetStatuses      Json?        // string[]

  /// Extra rule-specific parameters (e.g. { minDaysSinceLastContact: 30 }).
  params              Json?

  active              Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  campaign            Campaign?          @relation("CampaignReminderRules", fields: [campaignId], references: [id], onDelete: Cascade)
  messageTemplate     MessageTemplate?   @relation(fields: [messageTemplateId], references: [id])
  logs                ReminderLog[]

  @@index([kind, active])
  @@index([campaignId])
}

/// One row per reminder attempt — whether scheduled, sent, failed, or suppressed.
/// The runner writes a SCHEDULED row, then the sender updates it to SENT/FAILED.
/// Suppressed rows explain why a send was skipped (cooldown, cap, opt-out).
model ReminderLog {
  id                String             @id @default(cuid())
  reminderRuleId    String
  careProviderId    String

  /// Set for CAMPAIGN_FOLLOWUP rules where the member row is the unit of work.
  campaignMemberId  String?

  status            ReminderSendStatus @default(SCHEDULED)
  scheduledFor      DateTime           // when the runner intends to send
  sentAt            DateTime?

  /// FK to the WhatsAppMessage row that was created on send.
  whatsappMessageId String?            @unique

  /// Human-readable reason when status is FAILED or SUPPRESSED.
  reason            String?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  reminderRule      ReminderRule    @relation(fields: [reminderRuleId], references: [id], onDelete: Cascade)
  careProvider      CareProvider    @relation(fields: [careProviderId], references: [id], onDelete: Cascade)
  campaignMember    CampaignMember? @relation(fields: [campaignMemberId], references: [id])

  @@index([reminderRuleId, status])
  @@index([careProviderId, createdAt])
  @@index([status, scheduledFor])
}

// ============================================================================
// GIGS — transactional dispatch (broadcast → interest → assign → reconfirm
//        → complete). Replaces the old Job/JobOffer first-accept-wins model.
// ============================================================================

enum GigType {
  SAMPLE_COLLECTION   // phlebo collects a blood sample, drops to lab
  HOME_NURSING_VISIT  // nurse visits patient (drug admin, dressing, etc.)
  OTHER
}

enum GigStatus {
  DRAFT       // being set up by ops
  OPEN        // broadcasting / collecting willingness
  ASSIGNED    // ops picked a provider, awaiting their reconfirmation
  CONFIRMED   // provider reconfirmed; full details revealed; locked
  COMPLETED   // provider submitted the SOP completion form
  CANCELLED
}

/// Reflects where the chosen provider is in the reconfirm handshake.
/// Distinct from GigStatus so we can model "assigned but not yet confirmed".
enum GigAssignmentStatus {
  NONE        // nobody assigned yet
  AWAITING    // assigned, waiting for provider to reconfirm
  CONFIRMED   // provider locked it in
  EXPIRED     // confirm window passed without response (fallback triggered)
}

enum GigResponseStatus {
  NOTIFIED    // broadcast delivered, no reply yet
  INTERESTED  // provider raised their hand ("I'm available")
  DECLINED    // provider said no
  EXPIRED     // gig was filled/cancelled before they replied
}

/// One transactional task — a single provider's job. Created by ops (later
/// via API). Broadcast to matched providers in waves; ops assigns one from
/// the willing; that provider reconfirms before details are revealed; they
/// complete the SOP form to close it.
model Gig {
  id              String      @id @default(cuid())
  type            GigType     @default(SAMPLE_COLLECTION)
  title           String      // short label for ops, e.g. "Blood draw — Mr. Rao"
  description     String?     // internal notes / instructions
  profileTypeId   String      // which role can do this (Nurse, Phlebo, ...)

  // ── Requester (who asked) — lightweight for v1 ──
  requesterName   String?     // clinic / lab / doctor / patient name
  requesterPhone  String?

  // ── Patient / site. The FULL address is private — only revealed to the
  //    confirmed provider. Area fields drive matching + the broadcast. ──
  patientName     String?
  siteAddress     String?     // full address — revealed on CONFIRMED only
  siteArea        String?     // neighbourhood/landmark shown in broadcast
  pincode         String?     // for pincode-equality matching
  lat             Float?      // for geo-radius matching
  lng             Float?

  /// When the service must happen. The whole broadcast→assign→confirm loop
  /// must converge before this. Drives wave-escalation timing.
  scheduledFor    DateTime

  /// Match radius (km) for the FIRST wave. Later waves widen this.
  radiusKm        Float       @default(8)
  /// Required skills: [{ attributeKey, values[] }]. Provider must be a
  /// superset. Later waves may relax this.
  requiredSkills  Json?

  payText         String?     // "₹350 / pickup"

  /// SOP form the provider fills to complete the gig. Reuses the form engine.
  sopFormTemplateId String?

  // ── Dispatch / wave state ──
  status          GigStatus   @default(DRAFT)
  /// Highest broadcast wave fired so far (1 = first/closest set).
  currentWave     Int         @default(0)

  // ── Assignment / reconfirm handshake ──
  assignedProviderId  String?
  assignmentStatus    GigAssignmentStatus @default(NONE)
  assignedAt          DateTime?
  /// Provider must reconfirm by this time, else fallback to standby.
  confirmDeadline     DateTime?
  confirmedAt         DateTime?

  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  profileType     ProfileType   @relation(fields: [profileTypeId], references: [id])
  sopFormTemplate FormTemplate? @relation("GigSopForm", fields: [sopFormTemplateId], references: [id])
  assignedProvider CareProvider? @relation("GigAssignee", fields: [assignedProviderId], references: [id])
  responses       GigResponse[]

  @@index([status])
  @@index([profileTypeId])
  @@index([scheduledFor])
  @@index([assignmentStatus, confirmDeadline])
}

/// One provider's participation in one gig's broadcast. The INTERESTED
/// rows (minus the assigned one) form the ranked standby bench.
model GigResponse {
  id              String            @id @default(cuid())
  gigId           String
  careProviderId  String

  status          GigResponseStatus @default(NOTIFIED)
  /// Which broadcast wave this provider was reached in (1, 2, ...).
  wave            Int               @default(1)
  /// Distance (km) at match time, for ranking the standby bench + display.
  distanceKm      Float?
  /// Channel the broadcast went out on.
  channel         MessageChannel?
  /// Public token for the "I'm available" response page.
  token           String            @unique @default(cuid())

  notifiedAt      DateTime?
  respondedAt     DateTime?         // when they hit interested/declined

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  gig             Gig          @relation(fields: [gigId], references: [id], onDelete: Cascade)
  careProvider    CareProvider @relation(fields: [careProviderId], references: [id], onDelete: Cascade)

  @@unique([gigId, careProviderId])
  @@index([status])
  @@index([careProviderId])
  @@index([gigId, status])
}
