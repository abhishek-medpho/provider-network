# --- Database ---
DATABASE_URL="postgresql://cpp:cpp_dev_password@localhost:5434/care_provider_platform?schema=public"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3030"

# --- Ultramsg (WhatsApp) ---
# Sign up at https://ultramsg.com, create an instance, grab token + instance ID
ULTRAMSG_INSTANCE_ID="instanceXXXXX"
ULTRAMSG_TOKEN="your_ultramsg_token"
ULTRAMSG_BASE_URL="https://api.ultramsg.com"
# Default country code prefix for outbound numbers (no plus, no leading zero)
ULTRAMSG_DEFAULT_COUNTRY_CODE="91"

# --- App ---
APP_BASE_URL="http://localhost:3030"
# Magic link / OTP token expiry (minutes)
WHATSAPP_LOGIN_LINK_TTL_MIN="15"

# --- Admin bootstrap ---
# Comma-separated list of phone numbers that are allowed to log into admin on first run
# Format: country code + number, no plus (e.g. "919876543210,919812345678")
ADMIN_ALLOWED_PHONES=""
